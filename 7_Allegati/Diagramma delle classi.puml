@startumlclass Personaggio {    -nome: String    -colore: String    -hp: int    -velocita: int    -recupero_Ultimate: double    -abilita: Abilita    -ultimate: Ultimate    -suoni: Map<String,Suono>    -mosseBase: List<Base>    +vaiAvanti():void    +vaiDietro():void    +vaiGiu():void}abstract class Mossa{    -nome: String    -descrizione: int    -suoni: List<Suono>    +colpisci(Personaggio): void}class Abilita{    -durata: int}class Ultimate{    -durata: int}class Base{}class Suono{    -nome: String    -source: String    +riproduci(): void}class Player{    -id: int    -colore: String    -personaggio: Personaggio    -periferica: ?}class Suono{    -nome: String    -source: String    +riproduci(): void}class PersonaggiManager{    -personaggi: List<Personaggio>    +getSidon():Personaggio    +getQuan():Personaggio    +getIvan():Personaggio    +getYasser():Personaggio}Mossa <|-- AbilitaMossa <|-- UltimateMossa <|-- BasePersonaggio *-- BasePersonaggio *-- UltimatePersonaggio *-- AbilitaMossa o-- SuonoPersonaggiManager o-- PersonaggioPersonaggio o-- SuonoPlayer o-- Personaggio@enduml
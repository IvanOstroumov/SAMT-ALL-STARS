@startumlenum InputType {    Keyboard    Controller}class CharacterData {    -name: String    -maxHp: int    -speed: float    -description: String    -winCount: int    -gamesPlayed: int}class Ability {    -name: String    -damage: int    -duration: float    -cooldown: float    +execute(): void}class Character {    -data: CharacterData    -currentHp: int    -ability: Ability    +move(): void    +jump(): void    +dash(): void    +punch(): void    +kick(): void    +takeDamage(amount: int): void    +useAbility(): void}class Player {    -id: int    -color: String    -inputType: InputType    -character: Character    +selectCharacter(data: CharacterData): void}class Map {    -name: String    -imagePath: String}class CharacterManager {    -characters: List<CharacterData>    +getCharByName(name: String): CharacterData    +getCharsFromJSON(): List<CharacterData>}class MapManager {    -maps: List<Map>    +getMapByName(name: String): Map}class PlayerController {    -player: Player    +handleInput(): void}class GameManager {    -players: List<Player>    -controllers: List<PlayerController>    -currentMap: Map    +startGame(): void    +endGame(): void}class UIManager {    +openMainMenu(): void    +openCharacterSelect(): void    +openMapSelect(): void    +openVictoryScreen(): void}Character *-- CharacterDataCharacter *-- AbilityCharacterManager o-- CharacterDataMapManager o-- MapPlayer --> CharacterPlayerController --> PlayerGameManager o-- PlayerGameManager o-- PlayerControllerGameManager --> MapUIManager --> GameManager@enduml